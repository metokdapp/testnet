# METOK — Monad Testnet
VITE_METOK_CONTRACT=0xd37956c44985c2154738425222376a9d63dcf0cb

# Comma-separated PUBLIC HTTPS RPC endpoints.
# Never put private API secrets in VITE_*; Vite embeds them into the browser bundle.
VITE_RPC_URLS=https://testnet-rpc.monad.xyz
VITE_EXPLORER_URL=https://testnet.monadscan.com

# METOK Testnet deployment block.
VITE_DEPLOYMENT_BLOCK=61810876

# MetaMask Connect uses Monad Testnet chain 10143 / 0x279f.
# No WalletConnect project ID is required. Analytics are disabled in source.
